{
  "name": "rtai-newspaper-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "test": "vitest run --configLoader runner --exclude \"tests/**\" --exclude \"scripts/**\"",
    "test:e2e": "playwright test",
    "issue": "node scripts/newspaper.mjs",
    "test:tool": "node --test scripts/newspaper.test.mjs",
    "issue:verify": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.1"
  }
}
